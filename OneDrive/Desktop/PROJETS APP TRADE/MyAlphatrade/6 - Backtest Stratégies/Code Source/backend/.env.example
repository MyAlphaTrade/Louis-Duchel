# Copier ce fichier en `.env` et ajuster si besoin.

# Secret de signature des JWT -- changez cette valeur en production.
JWT_SECRET=changez-moi-en-production

# Chemin du fichier SQLite. Relatif au dossier backend/ si pas absolu.
DB_PATH=data/strategylab.db

# Origines autorisees en CORS, separees par des virgules.
CORS_ORIGINS=http://localhost:5173

# Port d'ecoute du serveur.
PORT=8010

# Cle API Resend (resend.com) pour l'envoi de l'email de reinitialisation de
# mot de passe. Reutilise le meme service que le backend AlphaTrade -- meme
# cle possible, ou une nouvelle, au choix. Si absente, le lien est juste
# journalise dans les logs serveur (utile en dev) au lieu d'etre envoye.
RESEND_API_KEY=

# Expediteur affiche sur l'email de reinitialisation.
EMAIL_FROM=AlphaTrade Strategy Lab <noreply@myalphatrade.com>

# URL du frontend, utilisee pour construire le lien de reinitialisation
# (FRONTEND_URL/reset-password?token=...).
FRONTEND_URL=http://localhost:5173
