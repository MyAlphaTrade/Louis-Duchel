# Dist/ is its own git repository (Base44-linked, separate remote) — never track it here.
Dist/

# Large Base44 export backup — not source, not meant for version control.
alpha-intel-lab.zip

# Secrets — the bridge's local API key, generated per-machine, never committed.
EA_Bridge/bridge_api_key.txt

# Secret — the shared Telegram bot token (2026-08-19), placed once per
# machine that should send real alerts, never committed (see
# telegram_notifier.py's module docstring).
EA_Bridge/telegram_bot_token.txt

# Local entity database (replaces Base44) — per-machine data, never committed.
EA_Bridge/alphatg_local.db

# Instance lock (per-machine runtime state, see instance_lock.py) — never committed.
EA_Bridge/bridge_instance.lock

# Claude Code local permissions cache — accumulates command history that can
# include secrets typed during a session (e.g. test passwords), never committed.
.claude/settings.local.json
